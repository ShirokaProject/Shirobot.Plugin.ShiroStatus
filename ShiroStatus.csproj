<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Version>0.2.3</Version>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <DebugType>portable</DebugType>
    <ShiroBotPluginPackagingEnabled Condition="'$(Configuration)' == 'Release'">true</ShiroBotPluginPackagingEnabled>
    <!-- All bundled Models are host-provided, including ones this component does not use. -->
    <ShiroBotPluginSharedAssemblies>ShiroBot.Model.QQ;ShiroBot.Model.Discord;ShiroBot.Model.Telegram</ShiroBotPluginSharedAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ShiroBot.SDK" />
    <!-- 机器状态卡片用 Avalonia 渲染，与宿主 ShiroBot 1.0.4 的 Avalonia 12.2 对齐；Avalonia 由宿主提供。 -->
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Skia" />
    <Compile Remove="scripts/**/*.cs;Tests/**/*.cs" />
    <InternalsVisibleTo Include="ShiroStatus.Verification" />
    <EmbeddedResource Include="Assets/shirobana.png" LogicalName="ShiroStatus.Assets.shirobana.png" />
  </ItemGroup>

</Project>
