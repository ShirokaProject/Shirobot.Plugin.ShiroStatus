<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ShiroStatus.Cards"
             x:Class="ShiroStatus.Cards.MachineCard"
             x:DataType="vm:MachineCardViewModel"
             Width="340"
             HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
    <Design.DataContext>
        <vm:MachineCardViewModel />
    </Design.DataContext>

    <UserControl.Resources>
        <ResourceDictionary>
            <FontFamily x:Key="Mono">Menlo, SF Mono, Consolas, DejaVu Sans Mono, monospace</FontFamily>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="Surface" Color="#FAFAF8" />
                    <SolidColorBrush x:Key="Line" Color="#E8E8E3" />
                    <SolidColorBrush x:Key="Track" Color="#EAEAE5" />
                    <SolidColorBrush x:Key="TileBg" Color="#1C1D21" />
                    <SolidColorBrush x:Key="TileFg" Color="#FAFAF8" />
                    <SolidColorBrush x:Key="TextTitle" Color="#1C1D21" />
                    <SolidColorBrush x:Key="TextBody" Color="#33353B" />
                    <SolidColorBrush x:Key="TextMeta" Color="#8A8C93" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="Surface" Color="#16171B" />
                    <SolidColorBrush x:Key="Line" Color="#26282E" />
                    <SolidColorBrush x:Key="Track" Color="#25272D" />
                    <SolidColorBrush x:Key="TileBg" Color="#EDEDEA" />
                    <SolidColorBrush x:Key="TileFg" Color="#16171B" />
                    <SolidColorBrush x:Key="TextTitle" Color="#F2F2EF" />
                    <SolidColorBrush x:Key="TextBody" Color="#D6D7DB" />
                    <SolidColorBrush x:Key="TextMeta" Color="#8D9098" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="TextBlock.section">
            <Setter Property="Foreground" Value="{DynamicResource TextMeta}" />
            <Setter Property="FontSize" Value="9" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="LetterSpacing" Value="1" />
        </Style>
        <Style Selector="Border.rule">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="{DynamicResource Line}" />
        </Style>
    </UserControl.Styles>

    <Border CornerRadius="6" ClipToBounds="True" Background="{DynamicResource Surface}">
        <StackPanel Margin="18,18,18,12" Spacing="14">
            <!-- ===== 头部 ===== -->
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Border Width="34" Height="34" CornerRadius="8" Background="{DynamicResource TileBg}">
                    <!-- 只定高度，让 Path 按字形实际宽度居中；Margin 为视觉重心微调 -->
                    <Path Data="{Binding OsGlyph, Converter={x:Static vm:GeometryConverter.Instance}}"
                          Fill="{DynamicResource TileFg}" Stretch="Uniform" Height="{Binding OsGlyphSize}"
                          Margin="{Binding OsGlyphMargin}" UseLayoutRounding="False"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center" Spacing="1">
                    <TextBlock Text="{Binding HostName}" Foreground="{DynamicResource TextTitle}" FontSize="14.5"
                               FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding OsText}" Foreground="{DynamicResource TextMeta}" FontSize="9.5"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="1">
                    <TextBlock Text="开机" Classes="section" HorizontalAlignment="Right" />
                    <TextBlock Text="{Binding SystemUptimeText}" Foreground="{DynamicResource TextTitle}" FontSize="11"
                               FontWeight="SemiBold" HorizontalAlignment="Right" />
                </StackPanel>
            </Grid>

            <Border Classes="rule" />

            <!-- ===== 占用：分段指示条 ===== -->
            <StackPanel Spacing="12">
                <TextBlock Text="占用" Classes="section" />
                <ItemsControl ItemsSource="{Binding Meters}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:MachineMeter">
                            <StackPanel Spacing="6" Margin="0,0,0,12">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <TextBlock Text="{Binding Label}" Foreground="{DynamicResource TextTitle}" FontSize="11"
                                               FontWeight="SemiBold" VerticalAlignment="Bottom" />
                                    <TextBlock Grid.Column="1" Text="{Binding Caption}" Foreground="{DynamicResource TextMeta}"
                                               FontSize="9" Margin="8,0,0,1" VerticalAlignment="Bottom" />
                                    <TextBlock Grid.Column="2" Text="{Binding PercentText}" Foreground="{Binding Accent}"
                                               FontFamily="{StaticResource Mono}" FontSize="13" FontWeight="Bold"
                                               VerticalAlignment="Bottom" />
                                </Grid>
                                <!-- 内容宽 304：24 格 × 10.5 + 23 × 2.25 间距 -->
                                <ItemsControl ItemsSource="{Binding Segments}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="2.25" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:MachineSegment">
                                            <Border Width="10.5" Height="9" CornerRadius="1.5" Background="{DynamicResource Track}">
                                                <Border CornerRadius="1.5" Background="{Binding Fill}" IsVisible="{Binding IsLit}" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <Border Classes="rule" Margin="0,-12,0,0" />

            <!-- ===== 规格：两列键值 ===== -->
            <StackPanel Spacing="10">
                <TextBlock Text="规格" Classes="section" />
                <ItemsControl ItemsSource="{Binding Specs}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="2" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:MachineDetail">
                            <StackPanel Spacing="2" Margin="0,0,10,10">
                                <TextBlock Text="{Binding Label}" Foreground="{DynamicResource TextMeta}" FontSize="9" />
                                <TextBlock Text="{Binding Value}" Foreground="{DynamicResource TextBody}" FontSize="11"
                                           FontWeight="Medium" TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <Border Classes="rule" Margin="0,-10,0,0" />

            <!-- ===== ShiroBot ===== -->
            <ItemsControl ItemsSource="{Binding ShiroStats}" IsVisible="{Binding HasShiroStats}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:MachineDetail">
                        <StackPanel Spacing="2">
                            <TextBlock Text="{Binding Label}" Foreground="{DynamicResource TextMeta}" FontSize="9" />
                            <TextBlock Text="{Binding Value}" Foreground="{DynamicResource TextTitle}" FontSize="11.5"
                                       FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- ===== 底部：小图标 + ShiroBot / 生成时间 ===== -->
            <Grid ColumnDefinitions="Auto,*" Margin="0,2,0,0">
                <StackPanel Orientation="Horizontal" Spacing="5">
                    <Image Source="{Binding Mascot}" Width="16" Height="16" VerticalAlignment="Center" />
                    <TextBlock Text="ShiroBot" Foreground="{DynamicResource TextMeta}" FontSize="9.5"
                               FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding GeneratedText}" Foreground="{DynamicResource TextMeta}"
                           FontFamily="{StaticResource Mono}" FontSize="8.5" HorizontalAlignment="Right"
                           VerticalAlignment="Center" />
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
